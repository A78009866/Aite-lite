# Firebase Admin service account JSON (one-line string)
# Required for realtime DB, auth, and session storage.
SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Express session secret (use a strong random value in production)
SESSION_SECRET=change-me-to-a-random-string

# Cloudflare R2 credentials for media uploads
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=aite-media
R2_PUBLIC_DOMAIN=your-public-domain.r2.dev

# Web Push VAPID keys (optional)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Email sender (optional)
MAIL_SERVICE=gmail
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Admin username fallback (optional)
ADMIN_USERNAME=your-admin-username
ADMIN_UID=your-admin-uid

# Node environment
NODE_ENV=development
